---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found" description="Page not found.">
  <section class="relative pt-36 pb-28 px-6 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[500px] h-[250px] bg-accent/[0.03] rounded-full blur-[120px]"></div>
    </div>

    <div class="relative mx-auto max-w-md text-center">
      <p class="text-8xl font-bold text-text-primary/10 mb-2 tracking-tighter">404</p>
      <h1 class="text-2xl font-bold text-text-primary mb-3">Page Not Found</h1>
      <p class="text-text-muted text-sm mb-10 leading-relaxed">
        This page doesn't exist, or it may have been moved. Try heading back home.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-text-primary text-bg font-semibold text-sm hover:bg-white/90 transition-all shadow-lg shadow-white/5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12"/></svg>
        Back to Home
      </a>
    </div>
  </section>
</BaseLayout>
