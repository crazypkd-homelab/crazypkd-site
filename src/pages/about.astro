          </div>
          <span class="text-text-muted text-xs">Cloudflare</span>
        </div>
        <!-- OAuth -->
        <div class="flex flex-col items-center gap-3 group">
          <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-white/[0.06] flex items-center justify-center group-hover:border-accent/30 group-hover:bg-white/[0.06] transition-all">
            <svg class="w-7 h-7 text-text-muted group-hover:text-accent transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
          </div>
          <span class="text-text-muted text-xs">OAuth 2.0</span>
        </div>
        <!-- Git -->
        <div class="flex flex-col items-center gap-3 group">
          <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-white/[0.06] flex items-center justify-center group-hover:border-accent/30 group-hover:bg-white/[0.06] transition-all">
            <svg class="w-7 h-7 text-text-muted group-hover:text-[#f05032] transition-colors" viewBox="0 0 24 24" fill="currentColor"><path d="M23.546 10.93L13.067.452a1.55 1.55 0 00-2.188 0L8.708 2.627l2.76 2.76a1.838 1.838 0 012.327 2.341l2.66 2.66a1.838 1.838 0 011.9 3.039 1.837 1.837 0 01-2.6 0 1.846 1.846 0 01-.404-2.02l-2.48-2.48v6.53a1.834 1.834 0 01.992 3.037 1.838 1.838 0 01-2.6 0 1.838 1.838 0 01.538-2.99V9.21a1.838 1.838 0 01-.538-2.99l-2.72-2.72L.454 10.93a1.55 1.55 0 000 2.188l10.48 10.48a1.55 1.55 0 002.186 0l10.426-10.48a1.55 1.55 0 000-2.188"/></svg>
          </div>
