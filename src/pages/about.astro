          <span class="text-text-muted text-xs">REST APIs</span>
        </div>
        <!-- Microservices -->
        <div class="flex flex-col items-center gap-3 group">
          <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-white/[0.06] flex items-center justify-center group-hover:border-accent/30 group-hover:bg-white/[0.06] transition-all">
            <svg class="w-7 h-7 text-text-muted group-hover:text-accent transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-2.25-1.313M21 7.5v2.25m0-2.25l-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3l2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75l2.25-1.313M12 21.75V19.5m0 2.25l-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25"/></svg>
          </div>
          <span class="text-text-muted text-xs">Microservices</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About the Homelab -->
  <section class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <div class="relative rounded-3xl overflow-hidden border border-border">
        <div class="absolute inset-0 bg-gradient-to-br from-white/[0.03] to-transparent" aria-hidden="true"></div>
        <div class="relative p-8 md:p-12 lg:p-16">
          <p class="text-accent text-sm font-semibold tracking-wider uppercase mb-4">The Lab</p>
          <h2 class="text-2xl md:text-3xl font-bold text-text-primary tracking-tight mb-6 leading-snug">
            About This Homelab
          </h2>
          <div class="space-y-5 text-text-secondary leading-relaxed max-w-2xl">
            <p>
              A personal playground for exploring modern systems — cloud infrastructure,
              automation, and AI-driven tooling — through hands-on experimentation.
            </p>
            <p>
              The focus is understanding how things work end-to-end: how networking
              affects reliability, how automation compounds efficiency, and how
              complexity emerges through thoughtful composition.
            </p>
            <p>
              Everything here is built to learn — not just to ship.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="px-6 py-16 pb-24">
    <div class="mx-auto max-w-5xl">
      <p class="text-accent text-sm font-semibold tracking-wider uppercase mb-8">Principles</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-8">
        {[
          { label: 'Depth over breadth', desc: 'Understanding systems at every layer, not just the surface.' },
