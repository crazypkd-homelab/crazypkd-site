        <div class="flex flex-col items-center gap-3 group">
          <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-white/[0.06] flex items-center justify-center group-hover:border-accent/30 group-hover:bg-white/[0.06] transition-all">
            <svg class="w-7 h-7 text-text-muted group-hover:text-[#f4a41a] transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/></svg>
          </div>
          <span class="text-text-muted text-xs">IAM</span>
        </div>
        <!-- IntelliJ Plugins -->
        <div class="flex flex-col items-center gap-3 group">
          <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-white/[0.06] flex items-center justify-center group-hover:border-accent/30 group-hover:bg-white/[0.06] transition-all">
            <svg class="w-7 h-7 text-text-muted group-hover:text-[#fe315d] transition-colors" viewBox="0 0 24 24" fill="currentColor"><path d="M0 0v24h24V0H0zm2.5 21.5V2.5h7.025v1.525H4.025V20h5.5v1.5H2.5zm9.025-4h5v1.5h-5v-1.5zM21.5 21.5h-3V20h1.5V4h-1.5V2.5h3v19z"/></svg>
          </div>
          <span class="text-text-muted text-xs">IntelliJ Plugins</span>
        </div>
        <!-- REST APIs -->
        <div class="flex flex-col items-center gap-3 group">
          <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-white/[0.06] flex items-center justify-center group-hover:border-accent/30 group-hover:bg-white/[0.06] transition-all">
            <svg class="w-7 h-7 text-text-muted group-hover:text-accent transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/></svg>
