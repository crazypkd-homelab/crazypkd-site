---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
---

<BaseLayout title="About" description="AI-first system engineer building at the intersection of infrastructure, security, and intelligent automation.">
  <HeroSection
    title="About"
    subtitle="Building systems that think — at the intersection of infrastructure, security, and AI."
  />

  <!-- About Me -->
  <section class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-16 items-start">
        <div>
          <p class="text-accent text-sm font-semibold tracking-wider uppercase mb-3">Who I Am</p>
          <h2 class="text-3xl font-bold text-text-primary tracking-tight leading-snug">
            AI-First System Engineer
          </h2>
          <div class="mt-5 flex items-center gap-4">
            <a href="https://www.linkedin.com/in/pkdharun/" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-accent transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="https://github.com/crazypkd-homelab" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-accent transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
          </div>
        </div>
        <div class="text-text-secondary leading-relaxed">
          <p>
            I build secure, scalable systems — from enterprise IAM and backend services to
            homelab infrastructure and AI-driven tooling. I care about how things work
            end-to-end, and I learn best by building.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Stack — logo grid -->
  <section class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-accent text-sm font-semibold tracking-wider uppercase mb-8">Tech Stack</p>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-6">
        <!-- Java -->
        <div class="flex flex-col items-center gap-3 group">
          <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-white/[0.06] flex items-center justify-center group-hover:border-accent/30 group-hover:bg-white/[0.06] transition-all">
            <svg class="w-7 h-7 text-text-muted group-hover:text-[#f89820] transition-colors" viewBox="0 0 24 24" fill="currentColor"><path d="M8.851 18.56s-.917.534.653.714c1.902.218 2.874.187 4.969-.211 0 0 .552.346 1.321.646-4.699 2.013-10.633-.118-6.943-1.149M8.276 15.933s-1.028.762.542.924c2.032.209 3.636.227 6.413-.308 0 0 .384.389.987.602-5.679 1.661-12.007.13-7.942-1.218M13.116 11.475c1.158 1.333-.304 2.533-.304 2.533s2.939-1.518 1.589-3.418c-1.261-1.772-2.228-2.652 3.007-5.688 0 0-8.216 2.051-4.292 6.573M19.33 20.504s.679.559-.747.991c-2.712.822-11.288 1.069-13.669.033-.856-.373.75-.89 1.254-.998.527-.114.828-.093.828-.093-.953-.671-6.156 1.317-2.643 1.887 9.58 1.553 17.462-.7 14.977-1.82M9.292 13.21s-4.362 1.036-1.544 1.412c1.189.159 3.561.123 5.77-.062 1.806-.152 3.618-.477 3.618-.477s-.637.272-1.098.587c-4.429 1.165-12.986.623-10.522-.568 2.082-1.006 3.776-.892 3.776-.892M17.116 17.584c4.503-2.34 2.421-4.589.968-4.285-.355.074-.515.138-.515.138s.132-.207.385-.297c2.875-1.011 5.086 2.981-.928 4.562 0 0 .07-.062.09-.118M14.401 0s2.494 2.494-2.365 6.33c-3.896 3.077-.889 4.832 0 6.836-2.274-2.053-3.943-3.858-2.824-5.539 1.644-2.469 6.197-3.665 5.189-7.627M9.734 23.924c4.322.277 10.959-.154 11.116-2.198 0 0-.302.775-3.572 1.391-3.688.694-8.239.613-10.937.168 0 0 .553.457 3.393.639"/></svg>
          </div>
          <span class="text-text-muted text-xs">Java</span>
        </div>
        <!-- Spring Boot -->
        <div class="flex flex-col items-center gap-3 group">
          <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-white/[0.06] flex items-center justify-center group-hover:border-accent/30 group-hover:bg-white/[0.06] transition-all">
            <svg class="w-7 h-7 text-text-muted group-hover:text-[#6db33f] transition-colors" viewBox="0 0 24 24" fill="currentColor"><path d="M20.59 5.41a10.26 10.26 0 01.84 2.52A9.91 9.91 0 0112 22a9.91 9.91 0 01-9.43-13.07 10.26 10.26 0 01.84-2.52A9.91 9.91 0 0112 2a9.91 9.91 0 018.59 3.41zM12 4a8 8 0 00-7.44 10.93c.52-1.77 1.58-3.28 3.01-4.42A12.55 12.55 0 0112 8.56c1.57 0 3.08.38 4.43 1.95a8.07 8.07 0 013.01 4.42A8 8 0 0012 4z"/></svg>
