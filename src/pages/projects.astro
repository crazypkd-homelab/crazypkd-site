---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ProjectCard from '../components/ProjectCard.astro';

const entries = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Projects" description="Projects and experiments from the crazypkd homelab.">
  <HeroSection
    title="Projects"
    subtitle="Systems I'm building, platforms I'm running, and experiments I'm pushing forward."
  />

  <section class="px-6 py-16 pb-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl mb-10">
        <p class="text-accent text-sm font-semibold tracking-wider uppercase mb-3">Portfolio</p>
        <h2 class="text-3xl font-bold text-text-primary tracking-tight mb-4">What I'm Working On</h2>
        <p class="text-text-muted leading-relaxed">
          From live platforms to ongoing infrastructure work — each project is a vehicle for learning and building real systems.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {entries.map((entry) => (
          <ProjectCard
            title={entry.data.title}
            description={entry.data.description}
            href={entry.data.href}
            tags={entry.data.tags}
            featured={entry.data.featured}
            status={entry.data.status}
            icon={entry.data.icon}
          />
        ))}
      </div>

      <!-- GitHub CTA -->
      <div class="mt-10 text-center">
        <a
          href="https://github.com/crazypkd-homelab"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-6 py-3 rounded-xl border border-border hover:border-border-hover hover:bg-white/5 text-text-secondary text-sm font-medium transition-all"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          View all repositories on GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
