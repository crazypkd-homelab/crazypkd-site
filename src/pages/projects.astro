---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    title: 'DevPen',
    description:
      'Browser-based developer toolkit with 8 tools: Markdown Viewer, JSON Formatter, Diff Checker, Encode/Decode, JWT Debugger, Regex Tester, Case Converter, and Line Tools. Zero-server architecture — all processing happens client-side. Works fully offline as a PWA. No accounts, no data leaves the browser.',
    href: 'https://devpen.crazypkd.com/',
    tags: ['React', 'TypeScript', 'CodeMirror', 'PWA', 'TailwindCSS'],
    featured: false,
    status: 'live' as const,
    icon: '🖊️',
  },
  {
    title: 'CrazyHub',
    description:
      'Self-hosted cloud resource monitoring dashboard with plug-and-play provider architecture. Monitor AWS, Azure, GCP, and Cloudflare from a single Docker container — encrypted credentials, auto-sync scheduler, zero external dependencies.',
    href: '',
    tags: ['Next.js', 'Prisma', 'Docker', 'Multi-Cloud'],
    featured: false,
    status: 'local' as const,
    icon: '🚀',
  },
  {
    title: 'crazypkd.com',
    description:
      'This personal site — built with Astro and TailwindCSS, automatically deployed to Cloudflare Pages on every push via GitHub Actions. Fast, minimal, and fully open source.',
    href: 'https://crazypkd.com',
    tags: ['Astro', 'TailwindCSS', 'Cloudflare Pages'],
    featured: false,
    status: 'live' as const,
    icon: '🌐',
  },
  {
    title: 'Homelab Infrastructure',
    description:
      'The underlying infrastructure powering everything — networking, DNS, reverse proxies, container orchestration, and monitoring. All managed as code.',
    href: 'https://github.com/crazypkd-homelab',
    tags: ['IaC', 'Docker', 'Networking'],
    featured: false,
    status: 'evolving' as const,
    icon: '🏗️',
  },
];
---

<BaseLayout title="Projects" description="Projects and experiments from the crazypkd homelab.">
  <HeroSection
    title="Projects"
    subtitle="Systems I'm building, platforms I'm running, and experiments I'm pushing forward."
  />

  <section class="px-6 py-16 pb-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl mb-10">
        <p class="text-accent text-sm font-semibold tracking-wider uppercase mb-3">Portfolio</p>
        <h2 class="text-3xl font-bold text-text-primary tracking-tight mb-4">What I'm Working On</h2>
        <p class="text-text-muted leading-relaxed">
          From live platforms to ongoing infrastructure work — each project is a vehicle for learning and building real systems.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {projects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            href={project.href}
            tags={project.tags}
            featured={project.featured}
            status={project.status}
            icon={project.icon}
          />
        ))}
      </div>

    </div>
  </section>
</BaseLayout>
