---
interface Props {
  title: string;
  description: string;
  href?: string;
  tags?: string[];
  featured?: boolean;
  status?: 'live' | 'building' | 'planned';
  icon?: string;
}

const { title, description, href, tags = [], featured = false, status = 'live', icon = '' } = Astro.props;

const statusConfig: Record<string, { label: string; class: string }> = {
  live: { label: 'Live', class: 'bg-emerald-500/15 text-emerald-400' },
  building: { label: 'In Progress', class: 'bg-amber-500/15 text-amber-400' },
  planned: { label: 'Planned', class: 'bg-white/8 text-text-muted' },
};

const { label: statusLabel, class: statusClass } = statusConfig[status];
---

{href ? (
  <a
    href={href}
    target={href.startsWith('http') ? '_blank' : undefined}
    rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
    class:list={[
      'group relative block rounded-2xl overflow-hidden transition-all duration-300',
      'hover:scale-[1.01] hover:shadow-xl hover:shadow-black/20',
      featured
        ? 'md:col-span-2 bg-gradient-to-br from-accent/8 via-accent/3 to-transparent border border-accent/15 hover:border-accent/30'
        : 'border border-border bg-bg-card hover:bg-bg-card-hover hover:border-border-hover',
    ]}
  >
    <div class="p-7 md:p-8">
      <div class="flex items-start justify-between gap-4 mb-4">
        <div class="flex items-center gap-3">
          {icon && <span class="text-2xl">{icon}</span>}
          <h3 class:list={[
            'font-bold group-hover:text-accent transition-colors',
            featured ? 'text-xl text-text-primary' : 'text-lg text-text-primary',
          ]}>
            {title}
          </h3>
        </div>
        <span class:list={['px-2.5 py-1 rounded-full text-[11px] font-semibold uppercase tracking-wider shrink-0', statusClass]}>
          {statusLabel}
        </span>
      </div>
      <p class="text-text-secondary text-sm leading-relaxed mb-5 max-w-xl">{description}</p>
      <div class="flex items-center justify-between gap-4">
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.06] text-text-muted text-xs">
                {tag}
              </span>
            ))}
          </div>
        )}
        <span class="text-text-muted group-hover:text-accent group-hover:translate-x-1 transition-all text-sm shrink-0">
          &rarr;
        </span>
      </div>
    </div>
  </a>
) : (
  <div
    class:list={[
      'group relative block rounded-2xl overflow-hidden transition-all duration-300',
      featured
        ? 'md:col-span-2 bg-gradient-to-br from-accent/8 via-accent/3 to-transparent border border-accent/15'
        : 'border border-border bg-bg-card',
    ]}
  >
    <div class="p-7 md:p-8">
      <div class="flex items-start justify-between gap-4 mb-4">
        <div class="flex items-center gap-3">
          {icon && <span class="text-2xl">{icon}</span>}
          <h3 class:list={[
            'font-bold',
            featured ? 'text-xl text-text-primary' : 'text-lg text-text-primary',
          ]}>
            {title}
          </h3>
        </div>
        <span class:list={['px-2.5 py-1 rounded-full text-[11px] font-semibold uppercase tracking-wider shrink-0', statusClass]}>
          {statusLabel}
        </span>
      </div>
      <p class="text-text-secondary text-sm leading-relaxed mb-5 max-w-xl">{description}</p>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.06] text-text-muted text-xs">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
)}
