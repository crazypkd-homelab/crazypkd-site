---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
}

const { title, description, date, slug, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={`/blog/${slug}`}
  class="group flex flex-col rounded-2xl border border-border bg-bg-card hover:bg-bg-card-hover hover:border-border-hover hover:scale-[1.01] transition-all duration-300 overflow-hidden"
>
  <div class="p-6 md:p-7 flex-1 flex flex-col">
    <div class="flex items-center gap-3 mb-4">
      <time class="text-text-muted text-xs tracking-wide">{formattedDate}</time>
      <span class="w-1 h-1 rounded-full bg-white/20"></span>
      {tags.length > 0 && (
        <span class="text-accent/70 text-xs font-medium">{tags[0]}</span>
      )}
    </div>

    <h3 class="text-text-primary font-semibold text-base mb-3 group-hover:text-accent transition-colors leading-snug">
      {title}
    </h3>
    <p class="text-text-muted text-sm leading-relaxed line-clamp-2 flex-1">{description}</p>

    <div class="mt-5 pt-4 border-t border-white/[0.04] flex items-center justify-between">
      {tags.length > 1 && (
        <div class="flex flex-wrap gap-2">
          {tags.slice(1).map((tag) => (
            <span class="px-2.5 py-0.5 rounded-full bg-white/[0.04] text-text-muted text-[11px]">
              {tag}
            </span>
          ))}
        </div>
      )}
      <span class="text-text-muted group-hover:text-accent group-hover:translate-x-1 transition-all text-xs ml-auto">
        Read &rarr;
      </span>
    </div>
  </div>
</a>
